{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentenceMiner",
  "version": "0.1.0",
  "identifier": "com.daniel.sentenceminer",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420/index.html",
    "beforeDevCommand": "python3 dev_server.py"
  },
  "app": {
    "windows": [
      {
        "title": "SentenceMiner",
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
